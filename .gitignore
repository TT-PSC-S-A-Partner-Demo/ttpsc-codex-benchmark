# Machine-local state. Everything here is regenerated by init.sh or a run.

# Points at one person's checkout — bench.config.example is the tracked template.
bench.config

# Live run marker, written by run-begin.sh and consumed by run-end.sh.
.current-run

__pycache__/

# Run output. These are one machine's measurements, not part of the harness:
# token counts are not comparable across repos or accounts, so committing them
# invites false comparisons. Drop the lines below if you deliberately want the
# results in version control (e.g. publishing a benchmark).
results.csv
SCOREBOARD.md
logs/
